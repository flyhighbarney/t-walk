# MBTA V3 API key (free): https://api-v3.mbta.com/portal
# Without it the server runs on the public GTFS-realtime feeds only (polled, no streaming).
MBTA_API_KEY=

# Server
PORT=8787
HOST=127.0.0.1
# Where the imported GTFS database and downloads live
DATA_DIR=./data

# Contact sent in the User-Agent to MBTA and api.weather.gov (they ask for one)
CONTACT=t-walk-dev (you@example.com)

# Optional: replay a recording instead of connecting to the MBTA (see README)
# REPLAY_FILE=fixtures/replay/normal.ndjson
# Optional: pin the clock (ISO time) — used with REPLAY_FILE and in tests
# FAKE_NOW=2026-10-15T08:00:00-04:00
# Optional: import GTFS from a folder of .txt files instead of downloading
# GTFS_DIR=fixtures/gtfs

# Trip planning: OpenTripPlanner (npm run otp:serve) when it answers, else the built-in planner.
# OTP_URL=http://127.0.0.1:8080
# OTP_URL=off   (built-in planner only: small servers)

# Web push signing keys: run `npm run push:keys` (writes them to .env)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
