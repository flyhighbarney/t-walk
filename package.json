{
  "name": "t-walk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "npm run dev -w @twalk/server",
    "dev:web": "npm run dev -w @twalk/web",
    "build": "npm run build -w @twalk/web",
    "start": "npm run start -w @twalk/server",
    "gtfs:import": "npm run gtfs:import -w @twalk/server",
    "record": "node --disable-warning=ExperimentalWarning tools/replay/record.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/web",
    "lint": "oxlint .",
    "smoke:live": "node --disable-warning=ExperimentalWarning tools/smoke-live.ts",
    "lighthouse": "npm run build && node --no-deprecation tools/lighthouse.ts",
    "fixtures": "node tools/replay/make-fixtures.ts",
    "icons": "node tools/make-icons.ts",
    "otp:fetch": "node tools/otp.ts fetch",
    "otp:build": "node tools/otp.ts build",
    "otp:serve": "node tools/otp.ts serve",
    "smoke:plan": "node tools/smoke-plan.ts",
    "push:keys": "node tools/push-keys.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
